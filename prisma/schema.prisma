generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  WATER_PLANT
  BEVERAGE
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  DELIVERY_BOY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum DeliveryFrequency {
  DAILY
  WEEKLY
  MONTHLY
  ON_DEMAND
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CREDIT
  CARD
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum ProductUnit {
  PCS
  LITRE
  ML
  BOX
  CARTON
  KG
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  PARTIAL
  CANCELLED
}

enum InvoiceType {
  SALE
  WALK_IN
}

// ─── COMPANY ────────────────────────────────────────────────────────────────
model Company {
  id        String      @id @default(uuid())
  name      String
  type      CompanyType
  email     String?     @unique
  phone     String?
  address   String?
  city      String?
  state     String?
  gstNumber String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  userCompanies         UserCompany[]
  customers             Customer[]
  categories            Category[]
  products              Product[]
  productBoms           ProductBom[]
  invoices              Invoice[]
  payments              Payment[]
  carts                 Cart[]
  stockMovements        StockMovement[]
  expenseCategories     ExpenseCategory[]
  vendors               Vendor[]
  expenses              Expense[]
  recurringExpenses     RecurringExpense[]
  pettyCashTransactions PettyCashTransaction[]
  pettyCashBox          PettyCashBox?

  @@map("companies")
}

// ─── USER ───────────────────────────────────────────────────────────────────
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String
  firstName    String
  lastName     String
  phone        String? @unique
  role         Role    @default(STAFF)
  gender       Gender?
  address      String?
  city         String?
  isActive     Boolean @default(true)
  refreshToken String?

  userCompanies UserCompany[]
  invoices      Invoice[]     @relation("InvoiceCreatedBy")
  payments      Payment[]     @relation("PaymentCreatedBy")
  carts         Cart[]

  stockMovements StockMovement[] @relation("StockMovementCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

// ─── USER COMPANY JOIN TABLE ────────────────────────────────────────────────
model UserCompany {
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

// ─── CUSTOMER ───────────────────────────────────────────────────────────────

model Customer {
  id           String @id @default(cuid())
  customerCode String

  name   String
  phone  String
  email  String?
  type   CustomerType   @default(RESIDENTIAL)
  status CustomerStatus @default(PENDING)

  deliveryFrequency DeliveryFrequency @default(ON_DEMAND)
  paymentMode       PaymentMode       @default(CASH)
  notes             String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  landmark     String?

  outstandingBalance Float @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  pricing  CustomerPricing[]
  ledger   CustomerLedger[]
  invoices Invoice[]
  payments Payment[]
  carts    Cart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerCode, companyId])
  @@unique([phone, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@map("customers")
}

// ─── CUSTOMER PRICING ───────────────────────────────────────────────────────
model CustomerPricing {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId     String
  customerPrice Float
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  companyId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([companyId])
  @@index([customerId, productId])
  @@map("customer_pricing")
}

// ─── CUSTOMER LEDGER ────────────────────────────────────────────────────────

model CustomerLedger {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentMode PaymentMode?
  entryType   LedgerEntryType
  referenceNo String
  description String

  debitAmount  Float @default(0)
  creditAmount Float @default(0)

  cgst Float @default(0)
  sgst Float @default(0)
  igst Float @default(0)

  balance   Float
  entryDate DateTime
  companyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([companyId])
  @@index([customerId, entryDate])
  @@index([companyId, entryType])
  @@map("customer_ledger")
}

// ─── CATEGORY ───────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String
  color       String  @default("#2563eb")
  bg          String  @default("#dbeafe")
  description String?
  isActive    Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, companyId])
  @@unique([name, companyId])
  @@index([companyId])
  @@index([companyId, isActive])
  @@map("categories")
}

// ─── PRODUCT ────────────────────────────────────────────────────────────────

model Product {
  id          String  @id @default(cuid())
  name        String
  sku         String
  description String?
  hsn         String?

  unit   ProductUnit   @default(PCS)
  status ProductStatus @default(ACTIVE)

  isSellable Boolean @default(true)

  consumesBom Boolean @default(false)

  // ─── Pricing ───
  basePrice Float
  costPrice Float @default(0)
  gstRate   Float @default(0)

  // ─── Inventory ───
  stock    Int @default(0)
  minStock Int @default(0)

  reserved Int @default(0)
  damaged  Int @default(0)

  stockMovements StockMovement[]

  // ─── Relations ───
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceItems InvoiceItem[]
  cartItems    CartItem[]

  // ─── BOM back-relations        
  bomLines   ProductBom[] @relation("BomParent")
  usedInBoms ProductBom[] @relation("BomComponent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sku, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([categoryId])
  @@map("products")
}

// ─── INVOICE ────────────────────────────────────────────────────────────────
model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String

  // Customer can be null for walk-in sales
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  // Walk-in customer info (used when customerId is null)
  walkInName  String?
  walkInPhone String?

  invoiceType InvoiceType   @default(SALE)
  status      InvoiceStatus @default(CONFIRMED)

  invoiceDate DateTime  @default(now())
  dueDate     DateTime?

  // Amounts
  subtotal    Float @default(0)
  cgst        Float @default(0) // Central GST (9%)
  sgst        Float @default(0) // State GST (9%)
  igst        Float @default(0) // Interstate GST (18%) - used when inter-state
  totalAmount Float @default(0) // subtotal + all taxes
  paidAmount  Float @default(0) // how much has been paid so far
  balanceDue  Float @default(0) // totalAmount - paidAmount

  gstEnabled Boolean @default(false) // was GST applied on this invoice?
  gstRate    Float   @default(18) // GST % used (18% default in India)
  notes      String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String
  createdBy   User   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invoiceNumber, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, invoiceDate])
  @@index([customerId])
  @@map("invoices")
}

// ─── INVOICE ITEM ───────────────────────────────────────────────────────────
model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName String // snapshot of product name
  sku         String // snapshot of SKU
  unit        String // snapshot of unit (PCS, LITRE, etc.)

  quantity  Int
  unitPrice Float // price per unit (may be custom price for this customer)
  discount  Float @default(0) // discount amount (not %)
  taxAmount Float @default(0) // GST on this line item
  lineTotal Float // (unitPrice × qty) - discount + tax

  companyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([companyId])
  @@index([productId])
  @@map("invoice_items")
}

// ─── PAYMENT ────────────────────────────────────────────────────────────────

model Payment {
  id            String @id @default(cuid())
  paymentNumber String

  // Customer can be null for walk-in payments
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Walk-in payer info (used when customerId is null)
  walkInName  String?
  walkInPhone String?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  amount      Float
  paymentMode PaymentMode
  referenceId String?
  notes       String?

  paymentDate DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String
  createdBy   User   @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymentNumber, companyId])
  @@index([companyId])
  @@index([companyId, paymentDate])
  @@index([customerId])
  @@index([invoiceId])
  @@map("payments")
}

// ─── CART ───────────────────────────────────────────────────────────────────
model Cart {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Customer info (set when customer is selected in POS)
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  walkInName  String?
  walkInPhone String?
  invoiceType InvoiceType @default(SALE)

  // Cart-level settings (the toggles/fields in the cart panel)
  gstEnabled Boolean @default(false)
  gstRate    Float   @default(18)
  discount   Float   @default(0)
  notes      String?

  // Calculated totals (recalculated every time cart changes)
  subtotal    Float @default(0)
  cgst        Float @default(0)
  sgst        Float @default(0)
  totalAmount Float @default(0)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("carts")
}

// ─── CART ITEM ──────────────────────────────────────────────────────────────
model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productName String
  sku         String
  unit        String

  quantity  Int
  unitPrice Float
  lineTotal Float

  companyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

// MOVEMENT SOURCE ENUM
enum MovementSource {
  // Stock In reasons
  PRODUCTION
  PURCHASE
  CUSTOMER_RETURN
  OPENING_STOCK

  // Stock Out reasons
  SALE
  BOM_CONSUMED
  DELIVERY
  INTERNAL_USE
  DAMAGE

  // Adjust reason
  STOCK_COUNT_CORRECTION
}

// STOCK MOVEMENT MODEL

model StockMovement {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName String
  sku         String
  unit        String

  type   MovementType
  source MovementSource

  quantity Int

  balanceAfter Int

  referenceId String?
  remarks     String?

  createdById String
  createdBy   User   @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([productId])
  @@index([companyId, type])
  @@map("stock_movements")
}

// EXPENSE MODULE

enum ExpenseStatus {
  PAID
  APPROVED
  PENDING
  REJECTED
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PettyCashDirection {
  IN
  OUT
}

enum RolloverRule {
  NONE
  CARRY
  DEDUCT
}

//  Expense Category
model ExpenseCategory {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  color       String  @default("#64748b")
  bg          String  @default("#f1f5f9")
  icon        String  @default("folder")

  // Budget config
  monthlyBudget  Decimal      @default(0) @db.Decimal(12, 2)
  alertThreshold Int          @default(90)
  rolloverRule   RolloverRule @default(NONE)

  isActive Boolean @default(true)
  isSystem Boolean @default(false)

  expenses  Expense[]
  recurring RecurringExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("expense_categories")
}

//  Vendor / Supplier

model Vendor {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  category String
  phone    String
  email    String?
  gstin    String?
  notes    String?

  openingOutstanding Decimal @default(0) @db.Decimal(12, 2)
  isActive           Boolean @default(true)

  expenses  Expense[]
  recurring RecurringExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("vendors")
}

//  Expense

model Expense {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  expenseNo String

  vendorName String
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  description  String
  categoryId   String?
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName String

  amount    Decimal @db.Decimal(12, 2)
  gstAmount Decimal @default(0) @db.Decimal(12, 2)

  paymentMode PaymentMode
  status      ExpenseStatus @default(PENDING)
  date        DateTime
  notes       String?

  recurringId String?
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, expenseNo])
  @@index([companyId, date])
  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@map("expenses")
}

// Recurring Expense Schedule

model RecurringExpense {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String
  vendorName String
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  categoryId   String?
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName String

  frequency RecurringFrequency
  amount    Decimal            @db.Decimal(12, 2)
  nextDue   DateTime
  isPaused  Boolean            @default(false)

  reminderDays Int @default(5)

  reminderAckedFor DateTime?

  // Auto-generated expenses reference this
  generated Expense[]

  lastGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, nextDue])
  @@map("recurring_expenses")
}

//s Petty Cash

model PettyCashTransaction {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  txnNo       String
  direction   PettyCashDirection
  amount      Decimal            @db.Decimal(12, 2)
  description String

  handledById   String?
  handledByName String?

  balanceAfter Decimal  @db.Decimal(12, 2)
  txnDate      DateTime @default(now())

  isReconciled Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([companyId, txnNo])
  @@index([companyId, txnDate])
  @@map("petty_cash_transactions")
}

// Petty Cash Balance

model PettyCashBox {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  currentBalance Decimal   @default(0) @db.Decimal(12, 2)
  openingBalance Decimal   @default(0) @db.Decimal(12, 2)
  reconciledTill DateTime?

  updatedAt DateTime @updatedAt

  @@map("petty_cash_boxes")
}

model ProductBom {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation("BomParent", fields: [productId], references: [id], onDelete: Cascade)
  componentId     String
  component       Product  @relation("BomComponent", fields: [componentId], references: [id], onDelete: Restrict)
  quantityPerUnit Float
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, componentId])
  @@index([companyId])
  @@index([companyId, productId])
  @@index([componentId])
  @@map("product_boms")
}
